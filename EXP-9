EXPERIMENT 9: TD(0), SARSA and Q-Learning for Warehouse Robot
Aim

To implement TD(0), SARSA, and Q-Learning algorithms for a warehouse robot to optimize navigation and obstacle avoidance.

import numpy as np

states = 5
actions = 2

alpha = 0.5
gamma = 0.9

V = np.zeros(states)
Q_sarsa = np.zeros((states, actions))
Q_qlearn = np.zeros((states, actions))

for episode in range(100):

    state = 0

    for step in range(10):

        action = np.random.randint(actions)

        next_state = min(state + 1, states - 1)

        reward = 10 if next_state == states - 1 else -1

        # TD(0)
        V[state] += alpha * (
            reward + gamma * V[next_state] - V[state]
        )

        # SARSA
        next_action = np.random.randint(actions)

        Q_sarsa[state, action] += alpha * (
            reward + gamma * Q_sarsa[next_state, next_action]
            - Q_sarsa[state, action]
        )

        # Q-Learning
        Q_qlearn[state, action] += alpha * (
            reward + gamma * np.max(Q_qlearn[next_state])
            - Q_qlearn[state, action]
        )

        state = next_state

print("TD(0) Values:")
print(np.round(V, 2))

print("\nSARSA Q-Values:")
print(np.round(Q_sarsa, 2))

print("\nQ-Learning Q-Values:")
print(np.round(Q_qlearn, 2))
